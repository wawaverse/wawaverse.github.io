---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  lang?: 'en' | 'it';
  category?: 'post' | 'poetry';
  unlisted?: boolean;
  translations?: Array<{
    lang: string;
    slug: string;
    title: string;
  }>;
}

const { title, description, pubDate, updatedDate, tags, lang = 'en', category, unlisted = false, translations = [] } = Astro.props;

const formattedDate = new Intl.DateTimeFormat(lang === 'it' ? 'it-IT' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: '2-digit'
}).format(pubDate);

const isPoetry = category === 'poetry';
const backUrl = isPoetry ? '/poetry' : '/';

const hasItalian = lang === 'it' || translations.some((t) => t.lang === 'it');
const hasEnglish = lang === 'en' || translations.some((t) => t.lang === 'en');
const itTranslation = translations.find((t) => t.lang === 'it');
const enTranslation = translations.find((t) => t.lang === 'en');
const basePath = isPoetry ? '/poetry' : '/blog';
---

<BaseLayout title={`${title} · yaoi.foundation`} description={description} showLogo={false} showHeader={false} noindex={unlisted}>
  <article class="post">
    <div class="top-nav">
      <a href={backUrl} class="back-link">← back</a>
      {(hasItalian && hasEnglish) && (
        <div class="lang-switch">
          <span class="lang-label">lang:</span>
          {lang === 'en' ? (
            <span class="lang-active">en</span>
          ) : (
            <a href={`${basePath}/${enTranslation?.slug}`} class="lang-link">en</a>
          )}
          <span class="lang-sep">/</span>
          {lang === 'it' ? (
            <span class="lang-active">it</span>
          ) : (
            <a href={`${basePath}/${itTranslation?.slug}`} class="lang-link">it</a>
          )}
        </div>
      )}
    </div>

    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {tags && tags.length > 0 && (
          <span class="tags">
            {tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </span>
        )}
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    width: 100%;
  }

  .top-nav {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }

  .back-link {
    font-size: 1rem;
  }

  .lang-switch {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 0.9rem;
    color: #6e6a86;
  }

  .lang-label {
    color: #6e6a86;
    margin-right: 0.15rem;
  }

  .lang-active {
    color: #c4a7e7;
    font-weight: 600;
  }

  .lang-link {
    color: #908caa;
    text-decoration: none;
  }

  .lang-link:hover {
    color: #c4a7e7;
    text-decoration: underline;
  }

  .lang-sep {
    color: #524f67;
  }

  .post-header {
    margin-bottom: 2rem;
    border-bottom: 1px dashed #524f67;
    padding-bottom: 1rem;
  }

  .post-title {
    margin: 0 0 0.5rem 0;
    font-size: 1.6rem;
  }

  .post-meta {
    color: #6e6a86;
    font-size: 0.85rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
  }

  .tag {
    color: #9ccfd8;
  }
</style>

<script>
  function setupHeadingAnchors() {
    const headings = document.querySelectorAll<HTMLElement>('.prose :is(h1, h2, h3, h4, h5, h6)');
    headings.forEach((heading) => {
      if (heading.classList.contains('sr-only') || heading.closest('.footnotes, [data-footnotes]')) {
        return;
      }
      if (heading.querySelector('.heading-anchor')) {
        return;
      }

      if (!heading.id) {
        const slug = heading.textContent
          ?.toLowerCase()
          .trim()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)/g, '');
        if (slug) heading.id = slug;
      }
      if (!heading.id) return;

      const anchor = document.createElement('a');
      anchor.className = 'heading-anchor';
      anchor.href = `#${heading.id}`;
      anchor.setAttribute('aria-label', `Link to ${heading.textContent?.trim() || 'section'}`);
      anchor.setAttribute('title', 'Copy link');

      const icon = document.createElement('span');
      icon.className = 'anchor-icon';
      icon.textContent = '#';

      const tooltip = document.createElement('span');
      tooltip.className = 'anchor-tooltip';
      tooltip.setAttribute('role', 'status');
      tooltip.setAttribute('aria-live', 'polite');
      tooltip.textContent = 'Copied!';

      anchor.appendChild(icon);
      anchor.appendChild(tooltip);

      let copyTimeout: number | undefined;

      anchor.addEventListener('click', async (e) => {
        e.preventDefault();
        const url = new URL(window.location.href);
        url.hash = heading.id;
        history.pushState(null, '', url.hash);

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(url.href);
          } else {
            const textarea = document.createElement('textarea');
            textarea.value = url.href;
            textarea.style.position = 'fixed';
            textarea.style.left = '-9999px';
            textarea.style.top = '-9999px';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.focus();
            textarea.select();
            document.execCommand('copy');
            textarea.remove();
          }

          clearTimeout(copyTimeout);
          anchor.classList.add('copied');
          copyTimeout = window.setTimeout(() => {
            anchor.classList.remove('copied');
          }, 1500);
        } catch (err) {
          console.error('Failed to copy link:', err);
        }

        heading.scrollIntoView({ behavior: 'smooth' });
      });

      heading.appendChild(anchor);
    });
  }

  setupHeadingAnchors();
  document.addEventListener('astro:page-load', setupHeadingAnchors);
</script>
